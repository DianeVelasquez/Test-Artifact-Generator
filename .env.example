# Framework related
BEE_FRAMEWORK_LOG_PRETTY=true
BEE_FRAMEWORK_LOG_LEVEL="info"
BEE_FRAMEWORK_LOG_SINGLE_LINE="false"

# LLM Provider Configuration
# Provider-neutral LLM configuration used by the application.
# OpenAI-compatible works with OpenAI, Ollama, LM Studio, vLLM, and compatible gateways.
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
# Optional generic base URL. Required for openai-compatible gateways.
# LLM_BASE_URL="https://api.openai.com/v1"

# Supported values: openai, openai-compatible, anthropic, gemini, watsonx.
# Aliases accepted for convenience: gpt -> openai, claude -> anthropic, google -> gemini.

# Optional WatsonX provider settings. Use these with LLM_PROVIDER="watsonx".
# WATSONX_CHAT_MODEL=""// Ejemplos: "meta-llama/llama-3-3-70b-instruct", "mistralai/mistral-medium-2505"
# WATSONX_EMBEDDING_MODEL=""
# WATSONX_API_KEY=""
# WATSONX_PROJECT_ID=""
# WATSONX_SPACE_ID=""
# WATSONX_VERSION=""
# WATSONX_REGION=""

# For Ollama LLM Adapter
# OLLAMA_CHAT_MODEL=""
# OLLAMA_EMBEDDING_MODEL=""
# OLLAMA_BASE_URL=""

# For OpenAI LLM Adapter
# OPENAI_CHAT_MODEL=""
# OPENAI_EMBEDDING_MODEL=""
# OPENAI_API_ENDPOINT=""
# OPENAI_API_KEY=""
# OPENAI_API_HEADERS=""

# For Azure OpenAI LLM Adapter
# AZURE_OPENAI_CHAT_MODEL=""
# AZURE_OPENAI_EMBEDDING_MODEL=""
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_API_ENDPOINT=""
# AZURE_OPENAI_API_RESOURCE=""
# AZURE_OPENAI_API_VERSION=""

# For Groq LLM Adapter
# GROQ_CHAT_MODEL=""
# GROQ_EMBEDDING_MODEL=""
# GROQ_API_HOST=""
# GROQ_API_KEY=""

# For Google Vertex Adapter
# GOOGLE_VERTEX_CHAT_MODEL=""
# GOOGLE_VERTEX_EMBEDDING_MODEL=""
# GOOGLE_VERTEX_PROJECT=""
# GOOGLE_VERTEX_ENDPOINT=""
# GOOGLE_VERTEX_LOCATION=""
# GOOGLE_APPLICATION_CREDENTIALS=""

# For Amazon Bedrock
# AWS_CHAT_MODEL=""
# AWS_EMBEDDING_MODEL=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_SESSION_TOKEN=""

# For Anthropic Adapter
# ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
# ANTHROPIC_CHAT_MODEL=""
# ANTHROPIC_EMBEDDING_MODEL=""
# ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
# ANTHROPIC_API_BASE_URL=""
# ANTHROPIC_API_HEADERS=""

# Gemini provider settings. Use these with LLM_PROVIDER="gemini".
# GEMINI_MODEL="gemini-1.5-pro"
# GEMINI_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# For XAI Adapter
# XAI_API_KEY=""
# XAI_CHAT_MODEL=""
# XAI_API_BASE_URL=""

# Tools
# CODE_INTERPRETER_URL="http://127.0.0.1:50081"

# For Google Search Tool
# GOOGLE_API_KEY="your-google-api-key"
# GOOGLE_CSE_ID="your-custom-search-engine-id"

# For SearXNG Search Tool
